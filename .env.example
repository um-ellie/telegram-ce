# ── Telegram CE configuration ────────────────────────────────────────────────
# Copy this file to `.env` and fill in your credentials.
# Get your API ID / API hash from https://my.telegram.org

TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Show incoming messages live while you type (1 = on, 0 = off)
TELEGRAM_CE_LIVE_FEED=1

# Set to 1 if your terminal shows raw garbage like "?[95m" instead of colors
# TELEGRAM_CE_PLAIN=1
